# noredirect | redirect | nohttps | nohttp
HTTPS_METHOD=redirect

TRUST_DOWNSTREAM_PROXY=true

# Default "*" in nginx.tmpl (any non-ingress). Set to your compose external network to limit upstreams, e.g. nginx-proxy.
# NGINX_PROXY_SHARED_NETWORK=nginx-proxy

# On backends: if docker-gen omits Networks/Addresses (nginx-proxy 1.10 + new Docker), the template falls back to
# server <container_name>:<VIRTUAL_PORT>; set VIRTUAL_PORT on the app when it is not 80.
